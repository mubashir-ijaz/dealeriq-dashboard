# Only needed for AI chatbot — get free at console.anthropic.com
# Leave blank to use dashboard without AI chat
REACT_APP_ANTHROPIC_KEY=your_anthropic_key_here

# Password to unlock the dashboard (simple client-side gate — set your own).
# Note: React env vars are baked into the public JS bundle at build time, so
# this deters casual access but is not a substitute for real backend auth.
REACT_APP_DASHBOARD_PASSWORD=your_dashboard_password_here
